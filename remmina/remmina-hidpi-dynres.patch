+/*
+ * Dynamic resolution on a HiDPI Wayland output: GTK renders the drawing area at
+ * an integer scale factor (2 on a 2x output), so a remote desktop sized to the
+ * logical allocation is upscaled by GTK and goes blurry. Instead ask the server
+ * for allocation * factor pixels and draw them back at 1 / factor, which is an
+ * exact pixel copy. On X11 or a 1x output the factor is 1 and nothing changes.
+ */
+static gboolean remmina_rdp_event_dynres_hidpi(rfContext *rfi)
+{
+	return rfi->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_DYNRES && rfi->hidpi_factor > 1;
+}
+
+/* Whether the remote framebuffer is drawn through cairo_scale(): scaled mode or HiDPI dynamic resolution */
+static gboolean remmina_rdp_event_is_scaled(rfContext *rfi)
+{
+	return rfi->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_SCALED || remmina_rdp_event_dynres_hidpi(rfi);
+}
