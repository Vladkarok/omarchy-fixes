# Maintainer: Sergej Pupykin <pupykin.s+arch@gmail.com>
# Maintainer: Robin Candau <antiz@archlinux.org>

pkgname=remmina
epoch=1
pkgver=1.4.44
pkgrel=2.1
pkgdesc="Remote desktop client written in GTK+"
url="https://www.remmina.org"
arch=('x86_64')
license=('GPL-2.0-or-later')
depends=('avahi' 'avahi-gtk' 'bash' 'cairo' 'curl' 'glib2' 'glibc' 'gtk3'
         'hicolor-icon-theme' 'json-glib' 'libappindicator' 'libgcc'
         'libgcrypt' 'libsodium' 'libssh' 'libx11' 'openssl' 'pango' 'python' 'vte3')
makedepends=('cmake' 'freerdp' 'gobject-introspection' 'gtk-vnc' 'harfbuzz'
             'kwallet5' 'libvncserver' 'ninja' 'spice-gtk' 'spice-protocol'
             'webkit2gtk-4.1' 'xorgproto')
optdepends=('freerdp: RDP plugin'
            'libsecret: Secret plugin'
            'libvncserver: VNC plugin'
            'spice-gtk: Spice plugin'
            #'pyhoca-cli: X2Go plugin'
            'webkit2gtk-4.1: WWW plugin'
            'gtk-vnc: GVNC plugin'
            'kwallet5: kwallet plugin'
            'gnome-terminal: external tools')
replaces=('remmina-plugins')
provides=('remmina-plugins')
source=("${pkgname}-${pkgver}.tar.gz::https://gitlab.com/Remmina/Remmina/-/archive/v${pkgver}/Remmina-v${pkgver}.tar.gz"
        "https://sources.debian.org/data/main/r/remmina/1.4.44%2Bdfsg-1/debian/patches/do-not-phone-home.patch"
        'remmina-hidpi-dynres.patch')
sha512sums=('235a67ef602e7fb9dd73e6b65ba6936f198141a264afdfb8296bb096602553f5e67c9575331c63cbc95097decd17b2ff46829810a013a7afd471f679c4d9584f'
            'a9d0addd8fb1bb1bc5b8b4dd84c11734f7eb312edec4df677e283ae602f0925453bcd23edf32787dd6c7cb821c55aff84ee1fba7c107c600933e2b5069fde92b'
            'SKIP')

prepare() {
	cd "Remmina-v${pkgver}"
	# Apply Debian patch to not phone home
	# See https://salsa.debian.org/debian-remote-team/remmina/-/blob/master/debian/patches/do-not-phone-home.patch
	patch -Np1 -i "${srcdir}/do-not-phone-home.patch"
	# Dynamic resolution in physical pixels on HiDPI Wayland outputs (local patch)
	patch -Np1 -i "${srcdir}/remmina-hidpi-dynres.patch"
}

build() {
	cmake -S "Remmina-v${pkgver}" -B build -G Ninja \
		-DCMAKE_BUILD_TYPE='None' \
		-DCMAKE_INSTALL_PREFIX='/usr' \
		-DCMAKE_INSTALL_LIBDIR='/usr/lib' \
		-DWITH_APPINDICATOR='ON' \
		-DWITH_FREERDP3='ON' \
		-DWITH_NEWS='OFF' \
		-DWITH_KF5WALLET='ON' \
		-DWITH_X2GO='ON' \
		-DWITH_GVNC='ON' \
		-Wno-dev
	cmake --build build
}

package() {
	DESTDIR="${pkgdir}" cmake --install build
}
