[Desktop Entry]
Name=Discord
StartupWMClass=discord
Comment=All-in-one voice and text chat for gamers that's free, secure, and works on both your desktop and phone.
GenericName=Internet Messenger
# XWayland, not native Wayland: Discord's keybind recorder (push-to-talk
# "Register Keybind") only listens for X11 key events, so on
# --ozone-platform=wayland it detects no keys at all. The explicit x11 flag
# overrides the ELECTRON_OZONE_PLATFORM_HINT=wayland that stock Omarchy's
# hypr/envs.lua exports. It must come before "--".
Exec=/usr/bin/discord --ozone-platform=x11 --url -- %u
Icon=discord
Type=Application
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/discord;
Path=/usr/bin
Terminal=false
