#!/bin/bash
# Keep claude-desktop at Anthropic's latest Linux release.
#
# Anthropic ships Linux builds only as .deb in their apt repo and the app has
# no self-updater there. The [omarchy] repo lags that by days and AUR by hours,
# and yay never checks AUR for a package that also exists in a sync repo. So:
# read the apt index directly, and when it is ahead of what is installed,
# rebuild the AUR PKGBUILD (the same .deb plus a Wayland launcher) against
# that version and install it.
set -euo pipefail

index=https://downloads.claude.ai/claude-desktop/apt/stable/dists/stable/main/binary-amd64/Packages
work=${XDG_CACHE_HOME:-$HOME/.cache}/claude-desktop-update

latest=$(curl -fsSL --max-time 30 "$index" | sed -n 's/^Version: //p' | sort -V | tail -1)
installed=$(pacman -Q claude-desktop 2>/dev/null | awk '{print $2}' | cut -d- -f1 || true)
[[ -n $latest ]] || { echo "no version in apt index" >&2; exit 1; }

if [[ -n $installed && $(vercmp "$latest" "$installed") -le 0 ]]; then
  echo "claude-desktop $installed is current"
  exit 0
fi

echo "claude-desktop $installed -> $latest"
if [[ -d $work/.git ]]; then
  git -C "$work" fetch -q && git -C "$work" reset -q --hard origin/HEAD
else
  git clone -q https://aur.archlinux.org/claude-desktop.git "$work"
fi
cd "$work"
sed -i "s/^pkgver=.*/pkgver=$latest/; s/^pkgrel=.*/pkgrel=1/" PKGBUILD
updpkgsums
makepkg -sfC --noconfirm
sudo pacman -U --noconfirm claude-desktop-"$latest"-1-*.pkg.tar.zst
notify-send "Claude Desktop updated" "$installed → $latest. Restart the app to use it."
